<a href="{{ url_for('index') }}">home</a>
<a class="btn" href="/users/{{ user.id }}/edit" title="Edit {{ user.name }}">edit</a>
<div class="card {{ 'active' if active else '' }} wide" id="card-{{ loop.index }}">
  <img src="{{ image.url }}" alt="{{ image.alt | e }}">
  <input type="text" name="q" value="{{ request.args.get('q', '') }}" {{ 'disabled' if locked }}>
  <option value="{{ o.id }}"{% if o.id == selected %} selected{% endif %}>{{ o.label }}</option>
</div>
