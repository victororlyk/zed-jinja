{# Upstream bug: Jinja tags looked too much like HTML tags. #}
{# Delimiters {% %} {{ }} and Jinja keywords must use scopes distinct from <tag> names. #}
{% extends "base.html" %}
{% block content %}
<section class="hero">
  {% include "partials/nav.html" %}
  <h1>{{ title | upper }}</h1>
  {% for post in posts %}
  <article>
    <h2>{{ post.title }}</h2>
    {% if post.draft %}<span class="badge">draft</span>{% endif %}
  </article>
  {% endfor %}
</section>
{% endblock %}
